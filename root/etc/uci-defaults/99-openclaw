#!/bin/sh
# luci-app-openclaw — 插件安装/升级初始化（最小化）
# 只做与“管理插件”相关的初始化：生成网关令牌、清理已退役残留、按需开机自启。
# openclaw 系统用户与 /opt/openclaw 运行目录改由「安装运行环境」(openclaw-env setup) 按所选安装路径创建——
# 装插件本身不再产生 /opt 足迹、也不创建系统用户（避免在选定安装路径前就落地默认 /opt，及未装运行时的残留）。

# 生成随机网关令牌（如尚未设置；令牌存 UCI，运行时经 env 注入网关）。
CURRENT_TOKEN=$(uci -q get openclaw.main.token)
if [ -z "$CURRENT_TOKEN" ]; then
	TOKEN=$(head -c 24 /dev/urandom | hexdump -e '24/1 "%02x"' 2>/dev/null || dd if=/dev/urandom bs=24 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' | head -c 48)
	uci set openclaw.main.token="$TOKEN"
	uci commit openclaw
fi

# Web PTY 已退役：清理旧安装残留（世界可读的 root 终端令牌 + 仍在运行的 root 终端进程）。
if [ -n "$(uci -q get openclaw.main.pty_token)" ] || [ -n "$(uci -q get openclaw.main.pty_port)" ]; then
	uci -q delete openclaw.main.pty_token
	uci -q delete openclaw.main.pty_port
	uci commit openclaw
fi
for _ptypid in $(pgrep -f 'web-pty.js' 2>/dev/null); do kill "$_ptypid" 2>/dev/null || true; done

# 启用服务自启动（仅当 enabled 非 0；尊重用户禁用选择）。
if [ -x /etc/init.d/openclaw ]; then
	OC_ENABLED=$(uci -q get openclaw.main.enabled)
	if [ "$OC_ENABLED" != "0" ]; then
		/etc/init.d/openclaw enable 2>/dev/null
	fi
fi

exit 0
